# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Which store this deployment serves (stores.slug)
STOREFRONT_SLUG=final-heaven
# Public site origin, used for payment redirects
SITE_URL=https://your-domain.com

# Flutterwave v3 (Dashboard -> Settings -> API Keys / Webhooks). Test keys contain _TEST; live keys don't.
FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key
# The "secret hash" you set on the webhook; Flutterwave sends it as the verif-hash header
FLW_SECRET_HASH=a-long-random-string

# Resend (resend.com -> API Keys, "Sending access" is enough). Server only.
RESEND_API_KEY=re_your-api-key
# Sender: must be an address on a domain verified in Resend (Domains).
EMAIL_FROM=Final Heaven <orders@your-domain.com>
# Optional: where customer replies go (otherwise replies go to EMAIL_FROM)
EMAIL_REPLY_TO=
# Optional: who gets "new paid order" and "new message" alerts (comma-separated)
STAFF_ALERT_EMAIL=

# Vercel Cron sends this as a bearer token to /api/cron/payments
CRON_SECRET=a-long-random-string
# Salt for hashing client IPs in rate-limit keys
RATE_LIMIT_SECRET=a-long-random-string

# Local tooling only (scripts, migrations). Never deployed.
SUPABASE_CONNECTION_STRING=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
